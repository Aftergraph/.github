{
  "$id": "aftergraph.runner-fabric/1.0",
  "title": "Aftergraph Runner Fabric Policy",
  "kind": "control-plane-policy",
  "authority": {
    "organization_policy": "Aftergraph/.github",
    "durable_work_scheduling": "Aftergraph/works-execution",
    "exact_head_verification": "repository-native verifier",
    "github_actions": "trigger-status-and-non-authoritative-integration-plane",
    "independent_verification": "Aftergraph/sentinel"
  },
  "queue": {
    "coalesce_key": "repository:pull_request",
    "desired_behavior": "latest_exact_sha_wins_before_execution",
    "priorities": [
      "hotfix",
      "promotion",
      "normal",
      "scheduled"
    ],
    "infrastructure_unavailable": "neutral_or_pending_not_code_failure",
    "code_failure": "failure",
    "obsolete_sha": "stale_without_success_claim",
    "mid_run_freshness": {
      "required_for_long_running_pr_jobs": true,
      "checkpoints": [
        "before_dependency_install",
        "before_primary_test_or_build"
      ],
      "obsolete_head_behavior": "neutral_skip_remaining_expensive_work",
      "authority_note": "freshness is scheduling evidence, never authorization"
    }
  },
  "pools": [
    {
      "id": "aftergraph-ci",
      "labels": [
        "self-hosted",
        "Linux",
        "X64",
        "aftergraph-ci"
      ],
      "purpose": "shared fast and normal verification",
      "target_queue_p95_seconds": 15,
      "target_warm_runners": 2,
      "status": "desired_not_yet_proven_org_visible"
    },
    {
      "id": "aftergraph-proof",
      "labels": [
        "self-hosted",
        "Linux",
        "X64",
        "aftergraph-proof"
      ],
      "purpose": "promotion, cross-repo and long-running proofs",
      "target_queue_p95_seconds": 30,
      "target_warm_runners": 1
    },
    {
      "id": "aftergraph-controlled-windows",
      "labels": [
        "self-hosted",
        "Windows",
        "X64"
      ],
      "purpose": "Windows-only controlled-host verification",
      "target_queue_p95_seconds": 30,
      "target_warm_runners": 1
    }
  ],
  "execution": {
    "one_runner_acquisition_per_gate": true,
    "promotion_proofs_only_on_promotion_or_manual_trigger": true,
    "exact_sha_receipt_required": true,
    "clean_room_dependencies": true,
    "persistent_source_checkout_for_untrusted_target_code": false,
    "github_hosted_runner_required": false
  },
  "security": {
    "fork_pull_requests_on_self_hosted": "deny_unless_explicitly_sandboxed",
    "persist_checkout_credentials": false,
    "cache_secrets": false,
    "cache_restores_are_untrusted_input": true,
    "authority_must_not_be_derived_from_runner_labels": true,
    "pool_membership_is_scheduling_not_authorization": true
  },
  "targets": {
    "queue_p50_seconds": 5,
    "queue_p95_seconds": 15,
    "fast_gate_p95_seconds": 120,
    "duplicate_heavy_proofs_per_sha": 0,
    "false_red_infrastructure_failures": 0
  },
  "rollout": {
    "phase": "bootstrap",
    "organization_visible_self_hosted_pool_proven": false,
    "activation_evidence_required": [
      "doctor:RUNNER_FABRIC_READY",
      "successful job in Aftergraph/.github using runner_label=aftergraph-ci",
      "recorded exact runner names and labels"
    ],
    "default_central_runner": "ubuntu-latest",
    "desired_self_hosted_runner": "aftergraph-ci"
  },
  "host_health": {
    "tmpfs": {
      "path": "/tmp",
      "max_used_percent": 85,
      "min_free_inodes": 10000,
      "deleted_open_listener_mappings": "observe_and_fail_under_pressure",
      "unhealthy_behavior": "infrastructure_unavailable_not_code_failure"
    },
    "listener_maintenance": {
      "recycle_only_when_idle": true,
      "require_no_runner_worker_child": true,
      "require_pressure": true,
      "require_deleted_open_mapping": true,
      "minimum_listener_age_seconds": 3600,
      "post_restart_readback": true
    }
  }
}
